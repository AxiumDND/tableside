{
  "name": "tableside",
  "version": "1.8.3",
  "description": "Tableside — in-person dual-monitor DM tool (D&D 5e, Pathfinder 2e, Vampire 5th)",
  "main": "./out/main/index.js",
  "author": "James",
  "license": "MIT",
  "homepage": "https://github.com/AxiumDND/tableside/releases/latest",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxiumDND/tableside.git"
  },
  "bugs": {
    "url": "https://github.com/AxiumDND/tableside/issues"
  },
  "scripts": {
    "dev": "node ./node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node ./node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "node ./node_modules/electron-vite/bin/electron-vite.js preview",
    "start": "node ./node_modules/electron/cli.js .",
    "lint": "eslint .",
    "typecheck:node": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "dist": "node ./node_modules/electron-vite/bin/electron-vite.js build && node ./node_modules/electron-builder/cli.js --win --publish never",
    "fetch-srd": "node scripts/fetch-srd.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "minisearch": "^7.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.tabledm.app",
    "productName": "Tableside",
    "copyright": "Copyright © 2026 James",
    "artifactName": "Tableside-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs/AI-CAMPAIGN.md",
        "to": "AI-CAMPAIGN.md"
      },
      {
        "from": "examples/greystead",
        "to": "examples/greystead"
      },
      {
        "from": "resources/srd-portraits",
        "to": "srd-portraits"
      },
      {
        "from": "resources/srd-items",
        "to": "srd-items"
      },
      {
        "from": "resources/srd-schools",
        "to": "srd-schools"
      },
      {
        "from": "resources/stock-art",
        "to": "stock-art"
      },
      {
        "from": "resources/npc-portraits",
        "to": "npc-portraits"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "AxiumDND",
      "repo": "tableside"
    },
    "win": {
      "icon": "resources/icon.ico",
      "executableName": "Tableside",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tableside",
      "uninstallDisplayName": "Tableside",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
